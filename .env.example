# Copy to .env.local (local dev) and add the same values in Vercel → Settings → Environment Variables.
# Leave the two NEXT_PUBLIC_SUPABASE_* empty to run in demo mode (no login, data stays in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose these.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# The only email allowed to sign in and edit. Use the same one in supabase/schema.sql.
ALLOWED_EMAIL=you@example.com
# Secret for the Siri shortcut: any random string of 32 characters or more (try: openssl rand -hex 24).
WALL_API_TOKEN=
# Optional: Claude model for commands.
WALL_MODEL=claude-haiku-5-5
# Optional: where you are. Weather is read for these coordinates and Claude resolves dates in this timezone.
NEXT_PUBLIC_WALL_LAT=53.385
NEXT_PUBLIC_WALL_LON=-6.257
NEXT_PUBLIC_WALL_TIMEZONE=Europe/Dublin
